PORT=3000
HOST=127.0.0.1
NODE_ENV=development
DATABASE_PATH=./data/invoices.db

# Stripe test mode for checkout and webhooks. Leave blank to run without payments.
# Never commit real values. Only sk_test_ or rk_test_ keys are accepted.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Where Stripe sends the browser after checkout. {INVOICE_ID} is replaced by the invoice ID.
CHECKOUT_SUCCESS_URL=http://localhost:5173/invoices/{INVOICE_ID}?checkout=success
CHECKOUT_CANCEL_URL=http://localhost:5173/invoices/{INVOICE_ID}?checkout=cancelled
