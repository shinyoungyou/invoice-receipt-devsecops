{
  "name": "invoice-receipt-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend bootstrap for the invoice and receipt DevSecOps project",
  "type": "module",
  "engines": {
    "node": ">=22.16 <23"
  },
  "scripts": {
    "start": "node --env-file=.env server.js",
    "dev": "node --watch --env-file=.env server.js",
    "test": "node --test",
    "pretest:coverage": "node -e \"require('node:fs').mkdirSync('coverage', { recursive: true })\"",
    "test:coverage": "cd .. && node --test --experimental-test-coverage --test-coverage-include=\"backend/**/*.js\" --test-coverage-exclude=\"backend/tests/**\" --test-coverage-exclude=\"**/node_modules/**\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=backend/coverage/lcov.info \"backend/tests/**/*.test.js\"",
    "check": "node scripts/check.js",
    "db:init": "node --env-file=.env scripts/init-db.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pdfkit": "^0.20.2",
    "stripe": "^23.1.0"
  }
}
